{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EXOCORTEX",
  "version": "0.7.0",
  "identifier": "com.exocortex.workspace",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "EXOCORTEX · Cognitive Workspace",
      "width": 1360,
      "height": 860,
      "minWidth": 960,
      "minHeight": 640,
      "backgroundColor": "#090d15"
    }],
    "security": {
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
